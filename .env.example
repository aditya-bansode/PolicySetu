# ==============================================================================
# PolicySetu — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure keys for your environment.
# NEVER commit .env with real secrets to public source control.
# ==============================================================================

# Application Security
SECRET_KEY=generate-a-secure-random-secret-key-for-production
FLASK_ENV=development
SESSION_COOKIE_SECURE=False

# Database (Default: local SQLite database)
DATABASE_URL=sqlite:///data/policysetu.db
TEST_DATABASE_URL=sqlite:///data/policysetu_test.db

# LLM Intelligence System Configuration
# Option A: Google Gemini (Recommended for PolicySetu multilingual civic-tech)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Option B: OpenAI or Compatible Endpoint
OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Monitoring Worker Settings
MONITORING_INTERVAL_MINUTES=15
DOCUMENT_STORAGE_DIR=data/documents/storage
MAX_DOCUMENT_SIZE_MB=25

# Server Port
PORT=5000
